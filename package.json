{
  "name": "react-hono",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "pnpm --filter ui dev",
    "build:ui": "pnpm --filter ui build",
    "lint:ui": "pnpm --filter ui lint",
    "preview:ui": "pnpm --filter ui preview",
    "deploy": "pnpm build:ui && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "wrangler": "^4.110.0"
  }
}
